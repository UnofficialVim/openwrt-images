freq_to_channel() {
	local freq=$1
	local ch=
	if [ "$freq" -lt 5000 ]; then
		ch=$(((freq-2412)/5+1))
		[ "$ch" -gt 14 ] && ch=14
	else
		ch=$(((freq-5180)/5+36))
	fi
	echo "$ch"
}

switch_channel() {
	local ch=$1
	local timestamp="$(uci get wireless.wireless.timestamp 2>/dev/null)"
	[ ! "$timestamp" ] && timestamp=2
	if [ "$ch" -lt 15 ]; then
		active_band="2.4"
		active_band_ch_txt="Channel_2_4GHz"
	else
		active_band="5"
		active_band_ch_txt="Channel_5GHz"
	fi
	log_debug "switch_channel afitool $timestamp $active_band $active_band_ch_txt $ch"
	afitool -c '{ "cmd": "set_wifi_config", "payload": [ { "LastUpdateTimestamp": "'$timestamp'" }, { "ActiveBand": "'$active_band' GHz", "'$active_band_ch_txt'": "'$ch'" } ] }' &> $AFITOOLLOG
}

set_returnurl() {
	local url="$1"
	[ -f "$RETURNURL" ] && sed -i "/^$REMOTE_ADDR/d" "$RETURNURL"
	echo "$REMOTE_ADDR $url" | head -n1  >> "$RETURNURL"
}

get_returnurl() {
	if [ -s "$RETURNURL" ]; then
		url=$(grep -E "^$REMOTE_ADDR" "$RETURNURL" | cut -d ' ' -f2-)
		[ "$url" ] && echo "$url" || echo "index.php"
		sed -i "/^$REMOTE_ADDR/d" "$RETURNURL"
	else
		echo 'index.php'
	fi
}

get_homeurl() {
	if [ -f "/etc/init.d/recovery" ]; then
		echo -n '.'
		return
	fi

	local json="$(ubus call ajconfd.Device GetNetworkConfig 2>/dev/null)"
	json_load "$json" > /dev/null
	json_get_var nw_wanbridgemode "Wan bridge mode"
	json_get_var nw_bypassdnscache "BypassDnsCache"
	json_cleanup

	if [ "$nw_wanbridgemode" = "1" ] || [ "$nw_bypassdnscache" = "1" ] || [ "$(ubus call ajconfd.ClusterNode GetProperty '{"name": "NodeRole"}' 2>/dev/null | grep '"value":' | awk '{print $2}')" = "1" ]; then
		echo -n '.'
	else
		echo -n 'http://amplifi.lan'
	fi
}

