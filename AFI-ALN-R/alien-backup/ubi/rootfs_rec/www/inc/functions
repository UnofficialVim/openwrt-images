config_teleport_wired() {

	log_debug "config_teleport_wired \"$1\" \"***\""

	local local_ssid="$1"
	local local_wifipassword="$2"

	if [ "$local_ssid" -a "$local_wifipassword" ]; then
		local timestamp="$(uci get wireless.wireless.timestamp 2>/dev/null)"
		[ ! "$timestamp" ] && timestamp=2

		ubus call ajconfd.ClusterNode SetInitialConfig '{"config": [{"LastUpdateTimestamp": "'"$timestamp"'"}, {"DeviceConfig": {"MlConnectivityMode": "Wired", "MlSkipSetupConfirmation": true, "MlIsolationMode": "Full"}, "WifiConfig": {"Ssid":"'"$local_ssid"'", "Password":"'"$local_wifipassword"'", "InternalSsid":"'"$local_ssid"'", "InternalPassword":"'"$local_wifipassword"'", "InternalEncryption":"Psk2", "UserNetworkEnabled": true, "InitialSetupNetworkEnabled": false}}]}' &> $AFITOOLLOG

	else
		ubus call ajconfd.Device SetDeviceConfig '{"config": {"MlConnectivityMode":"Wired"}}' &> $AFITOOLLOG

	fi
}

config_teleport_wireless() {

	log_debug "config_teleport_wireless \"$1\" \"***\" \"$3\" \"$4\" \"$5\" \"***\""

	local ssid="$1"
	local wifipassword="$2"
	local freq="$3"
	local open="$4"
	local local_ssid="$5"
	local local_wifipassword="$6"
	local ab="5 GHz"
	local encr="Psk2"
	local timestamp="$(uci get wireless.wireless.timestamp 2>/dev/null)"
	[ ! "$timestamp" ] && timestamp=2
	if [ "$freq" -lt 5000 ]; then
		ab="2.4 GHz"
	fi
	[ "$open" = "1" ] && encr="None"

	log_debug "afitool \"$timestamp\" \"$ab\" \"$ssid\" \"***\" \"$encr\" \"$local_ssid\" \"***\""

	if [ "$local_ssid" -a "$local_wifipassword" ]; then
		ubus call ajconfd.ClusterNode SetInitialConfig '{"config": [{"LastUpdateTimestamp": "'"$timestamp"'"}, {"DeviceConfig": {"MlConnectivityMode": "Wireless", "MlSkipSetupConfirmation": true, "MlIsolationMode": "Full"}, "WifiConfig": {"Ssid":"'"$local_ssid"'", "Password":"'"$local_wifipassword"'", "InternalSsid":"'"$local_ssid"'", "InternalPassword":"'"$local_wifipassword"'", "ActiveBand": "'"$ab"'", "WwanSsid": "'"$ssid"'", "WwanPassword": "'"$wifipassword"'", "WwanEncryption": "'"$encr"'", "RelayModeEnabled": false, "InternalEncryption":"Psk2", "UserNetworkEnabled": true, "InitialSetupNetworkEnabled": false}}]}'

	else
		afitool --defer -c  \
		"{\"cmd\":\"set_device_config\",\"payload\":\
			{\
				\"MlConnectivityMode\":\"Wireless\"\
			}\
		}" &> $AFITOOLLOG

		afitool --commit -c  \
		"{\"cmd\":\"set_wifi_config\",\"payload\":[\
			{\"LastUpdateTimestamp\":\"$timestamp\"},\
			{\
				\"ActiveBand\":\"$ab\",\
				\"WwanSsid\":\"$ssid\",\
				\"WwanPassword\":\"$wifipassword\",\
				\"WwanEncryption\":\"$encr\",\
				\"RelayModeEnabled\":\"False\",\
				\"Channel_2_4GHz\":\"-1\",\
				\"Channel_5GHz\":\"-1\"\
			}\
		]}" &> $AFITOOLLOG
	fi

}

