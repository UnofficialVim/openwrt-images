getvar() {
	local var
	var=$(echo "$1" | awk -F'&' '{for(i=1;i<=NF;i++){print $i}}' |\
		#grep "^$2=" | awk -F'=' '{print $2;}')
		grep "$2=" | awk -F'=' '{print $2;}')
	uhttpd -d "$var" 2>/dev/null
}

get_ptype() {
	local product
	local ptype
	local product="$(afi_board_name)"
	case "$product" in
	*"Router"*|*"AmpliFi X"*)
		ptype="Router"
		;;
	*"Mesh Point"*)
		ptype="MeshPoint"
		;;
	*"Teleport"*)
		ptype="Teleport"
		;;
	*"AmpliFi Power Box"*)
		ptype="PowerBox"
		;;
	*)
		ptype="Unknown"
		;;
	esac
	echo "$ptype"
}

get_pshortname() {
	echo "$(afi_board_shortname)"
}

get_role() {
	local role="unknown"
	local serialno="$(afi_ubnthal system.info serialno)"
	local shortname="$(afi_board_shortname)"
	json=$(ubus call uci get "{\"config\":\"ajconfd\",\"type\":\"registered_cluster_node\",\"match\":{\"platform_name\":\"$shortname\"}}")
	json_load "$json"
	json_select values
	json_get_keys keys
	for mac in $keys; do
		if [ "$mac" = "$serialno" ]; then
			json_select $mac
			json_get_var role role
			break
		fi
	done
	echo "$role"
}

