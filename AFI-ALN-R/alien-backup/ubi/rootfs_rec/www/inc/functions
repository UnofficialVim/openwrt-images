inetcheck_and_redirect() {
	local ic_status
	local ic_reason
	json_load "$(ubus call inetcheck check)"
	json_get_var ic_status "inet_status_str"
	json_get_var ic_reason "inet_reason_str"

	if [ "$ic_status" = "INET_STATUS_GREEN" ]; then
		echo "<meta http-equiv=\"refresh\" content=\"0;URL='connect.php'\" />"
	else
		if [ "$ic_reason" = "INET_REASON_NO_LINK" ]; then
			echo "<meta http-equiv=\"refresh\" content=\"0;URL='failed.php?reason=nolink'\" />"
		elif [ "$ic_reason" = "INET_REASON_NO_ADDR" ]; then
			echo "<meta http-equiv=\"refresh\" content=\"0;URL='failed.php?reason=noip'\" />"
		else
			echo "<meta http-equiv=\"refresh\" content=\"0;URL='failed.php?reason=nointernet'\" />"
		fi
	fi
}

validate_wifi_country() { # validates given country against available wifi countries
	local test_country="$1"
	local country
	local type
	local i=1

	[ ! "$test_country" ] && test_country="US"

	local json="$(ubus call ajconfd.Device GetWifiCountries 2>/dev/null)"
	json_load "$json" > /dev/null
	json_select "value" >/dev/null
	while json_get_type type $i && [ "$type" = "string" ]; do
		json_get_var country "$((i++))"
		[ "$country" = "$test_country" ] && break # test_country is valid choice
	done

	[ "$country" ] && echo -n "$country" || echo -n "$test_country"
}

get_setup_done() {
