	[ -s "$TOKENFILE" ] && sed -i "/^$REMOTE_ADDR/d" "$TOKENFILE"
}

get_teleport_ip() {
	local json="$(ubus call ajconfd.ClusterNode GetPeerList 2>/dev/null)"

	json_load "$json" > /dev/null
	json_get_keys keys
	for k in $keys; do
		json_select "$k"
		json_get_var ip "ip"
		json_get_var flags "flags"

		if [ "$((8 & $flags))" = "8" ]; then # if remote extender (TELEPORT)
			echo "$ip"
			return
		fi
		json_select
	done
}

teleport_setup_step=0
teleport_setup_state=0
teleport_status_id=0
teleport_status_msg=''

teleport_set_status() {
	teleport_setup_step="$1"
	teleport_setup_state="$2"
	teleport_status_id="$3"
	teleport_status_msg="$4"
}

log_debug() {
	logger "uhttpd: $@"
	echo "$@" >> "$DEBUGLOG"
}

teleport_state() {

	# 0

	# 100 - OK - ready for setup
	# 101 - WAITING - Input SSID and password
	# 105 - IN PROGRESS - Checking local connectivity
	# 110 - IN PROGRESS - establishing local connection
	# 120 - WAITING - captive portal - user input required
	# 130 - IN PROGRESS - checking wifi password and connecting
	# 140 - IN PROGRESS - set up Teleport AP

	# 150 - ERROR - no Internet Access - choose different connection
	# 155 - ERROR - Ethernet cable unplugged
	# 160 - ERROR - no IP address - choose different connection
	# 170 - ERROR - DNS server problem - choose different connection
	# 180 - ERROR - bad WiFi signal - move Teleport closer to AP or choose different WiFi network
	# 190 - ERROR - wrong WiFi password

	# 200 - IN PROGRESS - OK local connection
	# 210 - IN PROGRESS - connecting to Internet
	# 220 - IN PROGRESS - device_id received

	# 255 - ERROR - No Internet
	# 250 - ERROR - server not reachable - try again in a few minutes
	# 260 - ERROR - server problem (Teleport did not register) - try again in a few minutes
	# 270 - ERROR - router not online - try again in a few minutes

	# 300 - IN PROGRES - Internet OK
	# 310 - WAITING - pairing - waiting for pairing approval
	# 320 - IN PROGRES - contacting router

	# 350 - ERROR - could not get router IP or PORT
	# 360 - ERROR - pairing request was rejected - try again in a few minutes

	# 400 - IN PROGRES - OK Router
	# 401 - IN PROGRESS - Setting up teleport SSID
	# 405 - IN PROGRES - Getting network conflict info
	# 406 - IN PROGRES - Network conflict detected but still trying to set up connection

	# 410 - EXIT - OK TINC created, SPEEDTEST
	# 420 - IN PROGRES - setting up final SSID

	# 450 - ERROR - Router is not rachable - router did not answer to connection request
	# 460 - ERROR - IP network conflict

	# 500 - EXIT - OK SETUP FINISHED
	# 501 - IN PROGRES - Home network connection will be available shortly

	teleport_status_seconds_elapsed="$1"
	[ ! "$teleport_status_seconds_elapsed" ] && teleport_status_seconds_elapsed=0

	teleport_isolation_mode=$(uci get ajconfd.@device_config[0].ml_isolation_mode 2>/dev/null) # Full, CaptiveWan, !empty(Unknown)
	teleport_connectivity_mode=$(uci get ajconfd.@device_config[0].ml_connectivity_mode 2>/dev/null) # Wired, ?Wireless
	teleport_initial_setup_done=$(get_setup_done) # 1 0
	teleport_skip_setup_confirmation=$(uci get ajconfd.@device_config[0].ml_skip_setup_confirmation 2>/dev/null) # 1 empty
	ubus call ajconfd.Device GetPairing | grep -q "router" && teleport_is_paired=1 || teleport_is_paired=0 # 1 0

	teleport_tinc_enabled=$(uci get tinc.amplifi.enabled 2>/dev/null) # 1 0

	teleport_device_id=$(uci get ajconfd.@device_config[0].ml_device_id 2>/dev/null)

	teleport_mac=$(uci show ajconfd | grep -m 1 ".platform_name=\'AFi-T\'" | awk -F'.' '{print $2}');
	router_mac=$(uci show ajconfd | grep -m 1 ".role=\'router\'" | awk -F'.' '{print $2}');

	teleport_initial_sync_needed=$(uci ajconfd.$teleport_mac.initial_sync_needed 2>/dev/null) # 1 empty

	teleport_adoption_state=$(uci get tinc.$teleport_mac.adoption_state 2>/dev/null) # unknown  pending
	router_adoption_state=$(uci get tinc.$router_mac.adoption_state 2>/dev/null) # none  adopted

	router_public_ip=$(uci get tinc.$router_mac.Address 2>/dev/null)

	inet_status_str=$(ubus call inetcheck check | grep 'inet_status_str' | cut -d '"' -f 4) # INET_STATUS_RED INET_STATUS_GREEN
	inet_reason_str=$(ubus call inetcheck check | grep 'inet_reason_str' | cut -d '"' -f 4) # INET_REASON_NO_ADDR

	# sometimes after enetering isolation mode there are still files in /tmp/tinc/amplifi/conn/, give 20 seconds to remove them
	[ "$(ls /tmp/tinc/amplifi/conn/ 2>/dev/null)" ] && ( [ ! -s "$CONFIGMODELOCK" ] || [ "$(date -r "$CONFIGMODELOCK" +%s)" -lt "$(( $(date +%s) - 71 ))" ] ) && teleport_tinc_active=1

	# step 1 local connection, 2 Internet, 3 AmpliFi Router, 4 Home network (tinc), 5 Isolation (captive portal) off
	# state 1 ok, 2 in progress, 3 waiting, 4 error, 5 finished

	if [ "$teleport_is_paired" = "0" ]; then
		teleport_set_status 1 3 10 'Please pair with AmpliFi system'

	elif [ ! "$teleport_isolation_mode" ]; then # teleport in normal mode
		if [ "$(ip -4 a | grep 'br-lan' | grep 'scope' | grep -v ' 169.254' | cut -d'.' -f 4 | cut -d'/' -f 1)" != "1" ]; then
			teleport_set_status 5 1 500 'Everything is great!'

		else
			teleport_set_status 5 1 501 'Home network connection will be available shortly'

		fi

	elif [ "$teleport_isolation_mode" = "CaptiveWan" ]; then
		teleport_set_status 1 3 120 'Please complete authorization on captive portal'

	elif [ ! "$(uci get wireless.wireless.timestamp 2>/dev/null)" -a ! -s "$TELEPORTAP" ]; then
		teleport_set_status 1 3 101 'Enter Teleport SSID and password'

	else # Full
		if [ "$teleport_tinc_active" ]; then
			if [ -s "$TELEPORTAP" ]; then
				teleport_set_status 4 2 401 'Setting up Teleport SSID'

			elif [ "$teleport_skip_setup_confirmation" = 1 ]; then # if skip confirmation is set
				teleport_set_status 4 1 420 'Home network connection will be available shortly'

			else
				teleport_set_status 4 2 401 'Setting up Teleport SSID' # set skip confirmation

			fi

		elif [ "$inet_status_str" = "INET_STATUS_GREEN" ]; then
			if [ "$teleport_initial_setup_done" = "0" ]; then # initial setup not done
				if [ -s "$TELEPORTAP" ]; then
					teleport_set_status 1 2 140 'Setting up Teleport SSID'
				else
					teleport_set_status 1 3 101 'Enter Teleport SSID and password'
				fi

			elif [ "$teleport_adoption_state" = "adopted" ]; then
				if [ "$router_public_ip" ]; then

					json="$(ubus call ajconfd.MagicLink MlGetConnectivityStatus 2>/dev/null)"

					json_load "$json" > /dev/null
					json_get_var MlGetConnectivityStatus_same_network "same_network"
					json_get_var MlGetConnectivityStatus_network_conflict "network_conflict"
					json_select "status" > /dev/null
					json_get_var MlGetConnectivityStatus_error "error" > /dev/null

					if [ "$MlGetConnectivityStatus_same_network" = "yes" ]; then # Teleport and it's router are on the same network
						teleport_set_status 3 5 455 'Setup is finished. Relocate the Teleport to different network. This may include different home, office, public Wi-Fi, or mobile hotspot.'

					elif [ "$MlGetConnectivityStatus_network_conflict" = "yes" -a "$teleport_status_seconds_elapsed" -lt 90 ]; then # Teleport and it's router are on the same subnet (but not the same network), less than 90 seconds passed
						teleport_set_status 4 2 406 "Network conflict detected - still trying to set up connection. It is strongly recommended to connect Teleport to a different network or change Router's DHCP network range."

					elif [ "$MlGetConnectivityStatus_network_conflict" = "yes" ]; then # Teleport and it's router are on the same subnet (but not the same network)
						teleport_set_status 4 4 460 "Network conflict detected - home network connection could not be set up. Please connect Teleport to a different network or change Router's DHCP network range."

					elif [ "$MlGetConnectivityStatus_same_network" = "not_applicable" ]; then # waiting for info on network conflicts
						teleport_set_status 4 2 405 'Setting up secure connection'

					elif [ "$teleport_status_seconds_elapsed" -lt 90 ]; then # less than 90 seconds elapsed while trying to set up tinc
						teleport_set_status 4 2 400 'Setting up secure connection'

					else # 90 seconds elapsed and tinc not ready
						if [ ! "$MlGetConnectivityStatus_error" ]; then # if no error message
							teleport_set_status 4 2 400 'Setting up secure connection'

						else # error
							error_msg=$MlGetConnectivityStatus_error
							[ "$MlGetConnectivityStatus_error" = "Timeout (0) - Timeout" ] && error_msg="Router is not responding"
							[ "$MlGetConnectivityStatus_error" = "Connection failed: Connection refused - Timeout" ] && error_msg="Connection refused"
							teleport_set_status 4 4 450 "Could not create connection ($error_msg)"
							log_debug "showing error message: \"$MlGetConnectivityStatus_error\""

						fi
					fi
				else # router ip empty
					if [ "$teleport_status_seconds_elapsed" -lt 30 ]; then # less than 30 seconds elapsed while trying to get router ip or port
						teleport_set_status 3 2 320 'Looking for AmpliFi Router details'

					else
						teleport_set_status 3 4 350 'Router details are unknown. Possibly there is an UPnP problem (check using mobile app).'
					fi
				fi

			# add router offline handling here
			elif [ "$teleport_adoption_state" = "rejected" ]; then
				teleport_set_status 3 4 360 'AmpliFi owner declined pairing request'

			elif [ "$teleport_adoption_state" = "pending" ]; then
				teleport_set_status 3 3 310 'Open AmpliFi mobile app and accept pairing request' # Waiting for pairing approval

			elif [ "$teleport_device_id" ]; then
				teleport_set_status 2 2 220 'Making connection'

			else
				teleport_set_status 2 2 210 'Checking internet'

			fi

		elif [ -s "$WIFIPASSWORDCHECKLOCK" ] && [ "$(date -r "$WIFIPASSWORDCHECKLOCK" +%s)" -ge "$(( $(date +%s) - 30 ))" ]; then # if password check in progress
			teleport_set_status 1 2 130 'Checking WiFi password and connecting'

		elif [ -s "$WIFIPASSWORDCHECKRESULT" ]; then # if wrong password
			checked_ssid="$(cat $WIFIPASSWORDCHECKRESULT)"
			[ "$teleport_status_seconds_elapsed" -gt 15 ] && rm -f "$WIFIPASSWORDCHECKRESULT"
			teleport_set_status 1 2 190 "$checked_ssid"

		elif [ "$teleport_connectivity_mode" = "Wireless" ]; then
			if [ "$(iw wlan0 info 2>/dev/null | grep 'type managed')" ]; then # check if managed mode
				if [ "$(iw wlan0 info 2>/dev/null | grep '\tchannel')" ]; then # if associated
					if [ "$teleport_status_seconds_elapsed" -lt 90 ]; then
						teleport_set_status 2 2 200 'Connecting to internet'
					else
						teleport_set_status 2 4 255 'No internet connection detected'
					fi
				else
					teleport_set_status 1 2 110 'Connecting to WiFi'

				fi
			else
				teleport_set_status 1 3 100 'Select wireless network'

			fi

		elif [ "$teleport_connectivity_mode" = "Wired" ]; then
			if [ "$(cat /sys/class/net/eth0/carrier 2> /dev/null)" = "1" ]; then	# Ethernet cable connected
				if [ "$(ip route | grep default)" ]; then # is default route
					if [ "$teleport_status_seconds_elapsed" -lt 90 ]; then
						teleport_set_status 2 2 200 'Connecting to internet'
					else
						teleport_set_status 2 4 255 'No internet connection detected'
					fi

				else # no default route
					teleport_set_status 1 2 105 'Checking local connectivity'

				fi
			else # Ethernet cable not connected
				teleport_set_status 1 3 100 'Select wireless network or plug in Ethenet cable'

			fi
		else
			# fallback
			teleport_set_status 1 3 100 'Ready for setup'

		fi
	fi

	#echo "$(date +%s) $SCRIPT_NAME $teleport_status_id $teleport_status_msg" >> /tmp/webui.debug.statelog

	echo "teleport_setup_step id $teleport_setup_step" > /tmp/webui.debug.state
	echo "teleport_setup_state id $teleport_setup_state" >> /tmp/webui.debug.state
	echo "teleport_status_id id $teleport_status_id" >> /tmp/webui.debug.state
	echo "teleport_status_msg $teleport_status_msg" >> /tmp/webui.debug.state
	echo "teleport_status_seconds_elapsed $teleport_status_seconds_elapsed" >> /tmp/webui.debug.state
	echo "teleport_isolation_mode: $teleport_isolation_mode" >> /tmp/webui.debug.state
	echo "teleport_connectivity_mode: $teleport_connectivity_mode" >> /tmp/webui.debug.state
	echo "teleport_initial_setup_done: $teleport_initial_setup_done" >> /tmp/webui.debug.state
	echo "teleport_is_paired: $teleport_is_paired" >> /tmp/webui.debug.state
	echo "teleport_skip_setup_confirmation: $teleport_skip_setup_confirmation" >> /tmp/webui.debug.state
	echo "teleport_tinc_enabled: $teleport_tinc_enabled" >> /tmp/webui.debug.state
	echo "teleport_tinc_active: $teleport_tinc_active" >> /tmp/webui.debug.state
	echo "teleport_mac: $teleport_mac" >> /tmp/webui.debug.state
	echo "router_mac: $router_mac" >> /tmp/webui.debug.state
	echo "teleport_initial_sync_needed: $teleport_initial_sync_needed" >> /tmp/webui.debug.state
	echo "teleport_adoption_state: $teleport_adoption_state" >> /tmp/webui.debug.state
	echo "router_adoption_state: $router_adoption_state" >> /tmp/webui.debug.state
	echo "router_public_ip: $router_public_ip" >> /tmp/webui.debug.state
	echo "inet_status_str: $inet_status_str" >> /tmp/webui.debug.state
	echo "inet_reason_str: $inet_reason_str" >> /tmp/webui.debug.state
	echo "MlGetConnectivityStatus_error: $MlGetConnectivityStatus_error" >> /tmp/webui.debug.state
	echo "MlGetConnectivityStatus_same_network: $MlGetConnectivityStatus_same_network" >> /tmp/webui.debug.state
	echo "MlGetConnectivityStatus_network_conflict: $MlGetConnectivityStatus_network_conflict" >> /tmp/webui.debug.state
}
