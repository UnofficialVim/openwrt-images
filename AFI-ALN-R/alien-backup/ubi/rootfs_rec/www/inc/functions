validate_mac_addr() {
	[ "$(echo -n "$1" | tr -d '\n' | grep -Eq '^([0-9A-Fa-f]{2}[:\_-]){5}([0-9A-Fa-f]{2})$' && echo 1)" ] && echo -n "valid"
}

validate_strlen() {
	local len
	local str="$1"
	local lenmin="$2"
	local lenmax="$3"

	len=$(echo -n "$str" | wc -c)
	if [ "$len" -lt "$lenmin" -o "$len" -gt "$lenmax" ]; then
		# error
		echo "1"
	else
		# valid
		echo "0"
	fi
}

validate_initial() {
	local qs="$1"
	local ssid=$(getvar "$qs" "ssid")
	local wifipassword=$(getvar "$qs" "wifipassword")
	local samepass=$(getvar "$qs" "samepass")
	local admpassword
	if [ "$samepass" = "0" ]; then
		admpassword=$(getvar "$qs" "admpassword")
	fi

	if [ "$(validate_strlen "$ssid" 1 32)" -gt 0 ]; then
		echo "ssid"
	elif [ "$(validate_strlen "$wifipassword" 8 32)" -gt 0 ]; then
		echo "wifipassword"
	elif [  "$samepass" = "0" -a "$(validate_strlen "$admpassword" 1 32)" -gt 0 ]; then
		echo "admpassword"
	else
		echo "0"
	fi
}

validate_initial_mp() {
