#!/bin/sh

. html-start
. head-start

if [ "$(get_setup_done)" = "1" ]; then
	echo "<meta http-equiv=\"refresh\" content=\"0;URL='download.php'\" />"
	. head-stop
	. html-stop
	exit
fi

if [ "$REQUEST_METHOD" = "POST" ]; then
	read QUERY_STRING
	echo "$QUERY_STRING" > $SETUPFILE

	inv=$(validate_initial "$QUERY_STRING")
	if [ "$inv" != "0" ]; then
		echo "<meta http-equiv=\"refresh\" content=\"0;URL='setup.php?invalid=$inv'\" />"
		. head-stop
		. html-stop
		exit
	fi
	inetcheck_and_redirect

	. head-stop
	. html-stop
	exit
fi

if [ "$REQUEST_METHOD" = "GET" ]; then
	inetcheck=$(getvar "$QUERY_STRING" "ic")
	if [ "$inetcheck" = "0" ]; then
		echo "<meta http-equiv=\"refresh\" content=\"0;URL='connect.php'\" />"
		. head-stop
		. html-stop
		exit
	fi

	retry=$(getvar "$QUERY_STRING" "retry")
	if [ "$retry" = "1" ]; then
		inetcheck_and_redirect
		. head-stop
		. html-stop
		exit
	fi
fi

invalid=$(getvar "$QUERY_STRING" "invalid")

cat head.html
. head-stop

echo "<body>"

. body-nav

echo "\

	<div class='app-section-title'>
		<div class='container'>
