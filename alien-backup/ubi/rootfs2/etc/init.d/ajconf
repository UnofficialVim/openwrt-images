#!/bin/sh /etc/rc.common

START=75

USE_PROCD=1
NAME=ajconfd
PROG=/usr/sbin/ajconfd

start_service() {
	# Wait until other services we depend on are initialized.
	ubus -t 40 wait_for dhcp file network network.interface network.wireless ubnthal uci network.initialized

	procd_open_instance
	procd_set_param command nice -n -10 "$PROG"
	# Allow unlimited restarts with 5 seconds interval
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

